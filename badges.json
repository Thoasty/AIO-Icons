{
  "badges": [
    {
      "label": "REMUX",
      "match": "remux",
      "color": "#C6A56B",
      "border": "#C6A56B",
      "group": "src",
      "fields": [
        "quality"
      ]
    },
    {
      "label": "DV+HDR",
      "match": "HDR\\+DV|(?=.*\\bHDR)(?=.*\\bDV\\b)",
      "color": "#C6A56B",
      "border": "#C6A56B",
      "group": "hdr",
      "fields": [
        "visualTags"
      ]
    },
    {
      "label": "DV",
      "match": "\\bDV\\b",
      "color": "#C6A56B",
      "border": "#4A4A4A",
      "group": "hdr",
      "fields": [
        "visualTags"
      ]
    },
    {
      "label": "HDR10+",
      "match": "HDR10\\+",
      "color": "#EDE8DF",
      "border": "#EDE8DF",
      "group": "hdr",
      "fields": [
        "visualTags"
      ]
    },
    {
      "label": "HDR",
      "match": "\\bHDR(10)?\\b",
      "color": "#EDE8DF",
      "border": "#4A4A4A",
      "group": "hdr",
      "fields": [
        "visualTags"
      ]
    },
    {
      "label": "HLG",
      "match": "^HLG$",
      "color": "#8C8C8C",
      "border": "#2E2E2E",
      "group": "hdr",
      "fields": [
        "visualTags"
      ]
    },
    {
      "label": "BLURAY",
      "match": "^blu-?ray$",
      "color": "#EDE8DF",
      "border": "#4A4A4A",
      "group": "src",
      "fields": [
        "quality"
      ]
    },
    {
      "label": "WEB-DL",
      "match": "^web-?dl$",
      "color": "#8C8C8C",
      "border": "#4A4A4A",
      "group": "src",
      "fields": [
        "quality"
      ]
    },
    {
      "label": "WEBRIP",
      "match": "^web-?rip$",
      "color": "#8C8C8C",
      "border": "#4A4A4A",
      "group": "src",
      "fields": [
        "quality"
      ]
    },
    {
      "label": "IMAX",
      "match": "\\bimax\\b",
      "color": "#EDE8DF",
      "border": "#4A4A4A",
      "fields": [
        "visualTags",
        "editions",
        "filename"
      ]
    },
    {
      "label": "ATMOS",
      "match": "atmos",
      "color": "#C6A56B",
      "border": "#C6A56B",
      "group": "audio",
      "fields": [
        "audioTags"
      ]
    },
    {
      "label": "DTS:X",
      "match": "dts[:-]?x",
      "color": "#C6A56B",
      "border": "#4A4A4A",
      "group": "audio",
      "fields": [
        "audioTags"
      ]
    },
    {
      "label": "TRUEHD",
      "match": "truehd",
      "color": "#EDE8DF",
      "border": "#4A4A4A",
      "group": "audio",
      "fields": [
        "audioTags"
      ]
    },
    {
      "label": "DTS-HD MA",
      "match": "dts-hd ?ma",
      "color": "#EDE8DF",
      "border": "#4A4A4A",
      "group": "audio",
      "fields": [
        "audioTags"
      ]
    },
    {
      "label": "DD+",
      "match": "^dd\\+$",
      "color": "#8C8C8C",
      "border": "#4A4A4A",
      "group": "audio",
      "fields": [
        "audioTags"
      ]
    },
    {
      "label": "7.1",
      "match": "^7\\.1$",
      "color": "#8C8C8C",
      "border": "#2E2E2E",
      "group": "ch",
      "fields": [
        "audioChannels"
      ]
    },
    {
      "label": "5.1",
      "match": "^5\\.1$",
      "color": "#8C8C8C",
      "border": "#2E2E2E",
      "group": "ch",
      "fields": [
        "audioChannels"
      ]
    },
    {
      "label": "DUAL",
      "match": "\\bmulti\\b|^dual audio$",
      "color": "#EDE8DF",
      "background": "#2A2723",
      "border": "#2A2723",
      "group": "lang",
      "fields": [
        "languages",
        "filename",
        "folderName"
      ]
    },
    {
      "label": "DIR CUT",
      "match": "director",
      "color": "#8C8C8C",
      "border": "#2E2E2E",
      "group": "ed",
      "fields": [
        "editions"
      ]
    },
    {
      "label": "EXTENDED",
      "match": "extended",
      "color": "#8C8C8C",
      "border": "#2E2E2E",
      "group": "ed",
      "fields": [
        "editions"
      ]
    },
    {
      "label": "REMASTER",
      "match": "remaster",
      "color": "#8C8C8C",
      "border": "#2E2E2E",
      "group": "ed",
      "fields": [
        "editions"
      ]
    },
    {
      "label": "CRITERION",
      "match": "\\b(criterion|CC)\\b",
      "color": "#C6A56B",
      "border": "#4A4A4A",
      "fields": [
        "filename",
        "folderName"
      ]
    },
    {
      "label": "OPEN MATTE",
      "match": "open[ ._-]?matte",
      "color": "#EDE8DF",
      "border": "#2E2E2E",
      "fields": [
        "filename",
        "folderName"
      ]
    },
    {
      "label": "PROPER",
      "match": "\\b(repack|proper|rerip)\\d?\\b",
      "color": "#8C8C8C",
      "border": "#2E2E2E",
      "fields": [
        "filename"
      ]
    },
    {
      "label": "RD",
      "match": "^Ready RD$",
      "color": "#0E0E0E",
      "background": "#8C8C8C",
      "border": "#8C8C8C",
      "group": "svc",
      "fields": [
        "rseMatched"
      ]
    },
    {
      "label": "TB",
      "match": "^Ready TB$",
      "color": "#0E0E0E",
      "background": "#8C8C8C",
      "border": "#8C8C8C",
      "group": "svc",
      "fields": [
        "rseMatched"
      ]
    },
    {
      "label": "AD",
      "match": "^Ready AD$",
      "color": "#0E0E0E",
      "background": "#8C8C8C",
      "border": "#8C8C8C",
      "group": "svc",
      "fields": [
        "rseMatched"
      ]
    },
    {
      "label": "EN",
      "match": "^Ready EN$",
      "color": "#0E0E0E",
      "background": "#8C8C8C",
      "border": "#8C8C8C",
      "group": "svc",
      "fields": [
        "rseMatched"
      ]
    }
  ]
}